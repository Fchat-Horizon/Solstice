<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Solstice</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Scene-based life cycle, required by the iOS 26 / Xcode 27 SDK (apps built against it fail to
	     launch otherwise). Single scene (UIApplicationSupportsMultipleScenes false) keeps the app-level
	     background/foreground notification semantics identical to the old AppDelegate window. The
	     UISceneConfigurationName must match the name AppDelegate passes to UISceneConfiguration. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Keep-alive: NativeBackground loops an inaudible audio stream while connected to keep the
	     app process alive in the background, so the native WebSocket (NativeSocket) keeps answering
	     F-List PINs. Requires the `audio` mode. Under LiveContainer the host must honor background
	     audio for the guest. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Avoids the export-compliance prompt; the app uses only standard TLS. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Device Sync (NativeSync.swift) makes plain-HTTP requests to Horizon on the local network.
	     NSAllowsLocalNetworking exempts private/link-local hosts from App Transport Security without
	     opening up arbitrary internet cleartext; the usage string powers the iOS 14+ local-network
	     permission prompt shown on the first LAN connection. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Solstice connects to Horizon on your local network to sync chat logs between your devices.</string>
	<!-- Device Sync scans the QR code Horizon shows. -->
	<key>NSCameraUsageDescription</key>
	<string>Solstice uses the camera to scan the Device Sync QR code shown by Horizon.</string>
	<!-- A real launch storyboard is the unambiguous "supports full screen" signal. An empty
	     UILaunchScreen dict is fragile (and ignored under LiveContainer), which can drop the
	     app into letterbox/compatibility mode where the home indicator and safe-area insets
	     misbehave. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "tagMatch": "v[0-9][0-9][0-9][0-9].[0-9]*.[0-9]*",
    "requireBranch": "development",
    "requireCleanWorkingDir": true,
    "push": true,
    "pushArgs": []
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "pnpm typecheck",
      "pnpm test",
      "pnpm i18n:check",
      "pnpm check"
    ],
    "after:bump": "node scripts/sync-electron-version.js ${version}",
    "after:release": [
      "git push origin v${version}",
      "git push fork HEAD",
      "git push fork v${version}",
      "echo 'Branch and tag pushed to origin and fork, each tag on its own push so the release workflows fire. Next: pnpm release:notes:draft, edit release-notes/v${version}.md, wait for CI, then pnpm release:notes. See docs/releasing.md.'"
    ]
  }
}
